# Tendant operator-edge GraphQL — v1.
# Source of truth: specs/003-operator-edge-wake/contracts/graphql.v1.graphqls
# + per-phase additive deltas (Phase 3: specs/004-universal-gate-floor/,
#   Phase 4: specs/005-overseer-tool-grader/).
# Versioning policy: specs/003-operator-edge-wake/contracts/versioning-policy.md
#   — additive-by-default; field deprecation before any removal; a versioned
#   endpoint is reserved only for unavoidable breaking changes.
# Kept in sync; CI checks gqlgen drift.
#
# Every phase since Phase 1 has been strictly additive; no existing field has
# been renamed, removed, or retyped.

scalar Time
scalar JSON

# =========================================================================
# Phase 0/1 baseline — UNCHANGED.
# =========================================================================

enum TaskState     { PROPOSED ACCEPTED WAITING EXECUTING DONE DISMISSED HALTED }
enum ChainStage    { CREATION TRIAGE EXPANSION EXECUTION COMPLETION }
enum AutonomyLevel { NONE ENRICH_ONLY PROPOSE EXECUTE_GATED EXECUTE_AUTO }
# Owner-set coarse priority dial (defaults to NORMAL on the create screen).
enum TaskPriority  { LOW NORMAL HIGH URGENT }

interface Principal { id: ID!  globalUri: String!  displayName: String! }
type User implements Principal { id: ID!  globalUri: String!  displayName: String! }
type Bot  implements Principal { id: ID!  globalUri: String!  displayName: String! }

type WorkflowRef { id: ID!  startedAt: Time! }

type Task {
  id: ID!  globalUri: String!
  title: String!  description: String
  state: TaskState!
  currentStage: ChainStage!
  autonomy: AutonomyLevel!
  # Owner-set metadata (composed on the create screen). priority is never null
  # (defaults to NORMAL); dueAt is an optional deadline.
  priority: TaskPriority!
  dueAt: Time
  provenance: JSON
  contextRefs: JSON
  findings: JSON
  workflow: WorkflowRef
  openAssignment: AgentAssignment
  createdAt: Time!  editedAt: Time
}

type AgentAssignment {
  id: ID!
  task: Task!
  stage: ChainStage!
  fromAgent: Principal
  ask: String!
  gatheredContext: JSON
  createdAt: Time!
  resolvedAt: Time
}

type TaskEdge { node: Task!  cursor: String! }
type TaskConnection { edges: [TaskEdge!]!  pageInfo: PageInfo! }
type PageInfo { hasNextPage: Boolean!  endCursor: String }

type Query {
  viewer: User
  task(id: ID!): Task
  tasks(first: Int, after: String, state: TaskState): TaskConnection!
}

type Mutation {
  createTask(title: String!, description: String, priority: TaskPriority, dueAt: Time): Task!
  # Edit owner-set metadata after creation. Replace semantics: priority is
  # required (a task always has one); dueAt null clears any deadline.
  updateTaskMetadata(taskId: ID!, priority: TaskPriority!, dueAt: Time): Task!
  completeTask(taskId: ID!, result: JSON): Task!
  cancelTask(taskId: ID!): Task!
  acceptProposedTask(taskId: ID!): Task!
  dismissProposedTask(taskId: ID!, reason: String): Task!
}

# =========================================================================
# Phase 2 — additive surface starts here.
# =========================================================================

# ----- Sessions & device tokens (Clarification Q4) ----------------------

enum DevicePlatform { IOS ANDROID WEB }

type Session {
  id: ID!
  displayName: String!
  createdAt: Time!
  lastSeenAt: Time!
}

type SessionMintResult {
  session: Session!
  token: String!
}

# ----- Tools, approval payloads, decision kinds -------------------------

type Tool {
  id: ID!  globalUri: String!  name: String!
  rung: AutonomyLevel!
  permissions: JSON!
  overseerInstructions: String
}

type Artifact { kind: String!  content: JSON!  recipient: String }
type Mandate  { goal: String!  constraints: JSON!  guardrails: JSON! }

union ApprovalPayload = Artifact | Mandate

interface PendingDecision { id: ID!  task: Task!  createdAt: Time! }

type ApprovalRequest implements PendingDecision {
  id: ID!  task: Task!  createdAt: Time!
  tool: Tool!  payload: ApprovalPayload!
  # Phase 4 additive: non-null when the overseer was the layer that
  # escalated this approval. Null when the floor tripped (floor evidence
  # is implicit in the gate_verdict audit row) or when the overseer was
  # not consulted.
  overseerEvaluation: OverseerEvaluation
}

# Phase 4 additive: OverseerEvaluation carries the verdict + evidence the
# overseer wrote when it escalated an ApprovalRequest.
type OverseerEvaluation {
  verdict: String!
  summary: String!
  consideredFields: [String!]!
  modelId: String!
  provider: String!
  tokensIn: Int!
  tokensOut: Int!
  estimatedCostUsd: Float!
  at: Time!
}
type AgentQuestion implements PendingDecision {
  id: ID!  task: Task!  createdAt: Time!
  asker: Principal!  question: String!  disclosureClass: String
}
type PromotionProposal implements PendingDecision {
  id: ID!  task: Task!  createdAt: Time!
  tool: Tool!  fromLevel: AutonomyLevel!  toLevel: AutonomyLevel!  evidence: JSON!
}

# Post-completion feedback (additive, Path 1). After a task reaches DONE, the
# feedback workflow opens a CONVERSATION as a FeedbackRequest: the agent and the
# owner exchange messages; the agent maintains a `draftGuidance` proposal; the
# owner accepts a final guidance text (stored verbatim and injected into agent
# system prompts) and/or supplies a satisfaction rating that feeds calibration.
type FeedbackMessage {
  id: ID!
  role: String!   # "agent" | "user"
  content: String!
  createdAt: Time!
}

type FeedbackRequest implements PendingDecision {
  id: ID!  task: Task!  createdAt: Time!
  messages: [FeedbackMessage!]!
  # The agent's current draft of standing guidance — what acceptFeedbackGuidance
  # pre-fills (the owner can edit it before accepting). Null/empty until the
  # conversation yields a durable lesson.
  draftGuidance: String
  # A read-only digest of what happened on the completed task — the same context
  # the feedback agent saw, surfaced so the owner understands the basis for its
  # questions and guidance. Null when the digest cannot be built.
  context: FeedbackContext
}

# FeedbackContext is the compact, read-only summary of a completed task that the
# feedback agent grounds its conversation in: how many tools ran (and how many
# were flagged), which agent stages executed, whether the task was handed off,
# how much standing guidance already exists, and which read-only context tools
# the agent actually consulted this conversation.
type FeedbackContext {
  toolsRun: Int!
  toolsFlagged: Int!
  agentStages: [String!]!
  handoffReason: String
  activeGuidanceCount: Int!
  # Read-only context tools the agent called (e.g. "get_task_outcomes").
  consulted: [String!]!
  # One-line human-readable digest.
  summary: String!
}

# A feedback-authored standing-guidance note, injected verbatim into the
# matching agent's system prompt. scope is "global" or "agent".
type AgentGuidance {
  id: ID!
  note: String!
  scope: GuidanceScope!
  agentConfigId: ID
  createdAt: Time!
}

enum GuidanceScope { GLOBAL AGENT }

extend type Query {
  # Owner-only: list standing guidance notes by status ("active" default).
  agentGuidance(status: String): [AgentGuidance!]!
}

# ActionableTask wraps a Task that itself needs the owner directly — currently
# a PROPOSED task awaiting accept/dismiss. It joins the inbox union so the feed
# is the single home for everything requiring action (not just decisions).
type ActionableTask { id: ID!  task: Task!  createdAt: Time! }

union InboxItem = ApprovalRequest | AgentQuestion | PromotionProposal | AgentAssignment | FeedbackRequest | ActionableTask

# InboxEntry is the ranked envelope around an InboxItem. `urgency` is the blended
# server-computed score (owner priority + deadline proximity + intake stakes +
# age) the feed is sorted by, descending. `kind` mirrors the underlying source
# ("pending_decision" | "agent_assignment" | "task").
type InboxEntry {
  id: ID!
  kind: String!
  # Phase 9 additive: the fine-grained message type carried on the first-class
  # inbox_messages row — the single discriminator the client dispatches a detail
  # page on (approval_request | agent_question | promotion_proposal |
  # feedback_request | agent_assignment | actionable_task | …). Strictly more
  # specific than `kind`, which only names the source table.
  messageType: String!
  createdAt: Time!
  urgency: Float!
  # Phase 9 additive: per-message state from inbox_messages. Null until the
  # owner reads / dismisses the message (see markInboxRead / dismissInboxMessage).
  readAt: Time
  dismissedAt: Time
  item: InboxItem!
}

type InboxFeedPage {
  entries: [InboxEntry!]!
  # Opaque keyset cursor for the next page; null when this is the last page.
  nextCursor: String
}

# Phase 9 additive: the per-message state of a first-class inbox_messages row,
# returned by the read/dismiss mutations so the client can update one tile
# without re-fetching the feed.
type InboxMessageState {
  id: ID!
  seenAt: Time
  readAt: Time
  dismissedAt: Time
}

# ----- Notifications (subscription type) --------------------------------

type Notification {
  id: ID!
  kind: String!
  createdAt: Time!
  taskId: ID
}

# ----- Query additions --------------------------------------------------

extend type Query {
  # Ranked, keyset-paginated action feed. Replaces `inbox` — items appear only
  # when actionable and are sorted by blended urgency (see InboxEntry.urgency).
  inboxFeed(first: Int, after: String): InboxFeedPage!
  inbox(first: Int, after: String): [InboxItem!]! @deprecated(reason: "Use inboxFeed — ranked + actionable-only + absorbs proposed tasks.")
  pendingDecision(id: ID!): PendingDecision
  agentAssignment(id: ID!): AgentAssignment
  sessions: [Session!]!
}

# ----- Mutation additions ----------------------------------------------

extend type Mutation {
  pairDevice(password: String!, displayName: String!): SessionMintResult!
  revokeSession(sessionId: ID!): Session!

  registerDeviceToken(token: String!, platform: DevicePlatform!): Boolean!
  unregisterDeviceToken(token: String!): Boolean!

  # Phase 9 additive: per-message inbox state on the first-class inbox_messages
  # row. markInboxRead stamps read/seen; dismissInboxMessage soft-dismisses the
  # message from the active inbox WITHOUT resolving the underlying source row
  # (the action it represents is unaffected). Both are recipient-scoped.
  markInboxRead(id: ID!): InboxMessageState!
  dismissInboxMessage(id: ID!): InboxMessageState!

  approveArtifact(decisionId: ID!): PendingDecision!
  rejectApproval(decisionId: ID!, reason: String): PendingDecision!
  answerQuestion(decisionId: ID!, answer: String!): PendingDecision!
  # DEPRECATED (Phase 8). Superseded by respondToPromotion, which returns the
  # updated Tool instead of a PendingDecision. The stub continues to return
  # NOT_YET_AVAILABLE; do not build new clients against it.
  decidePromotion(decisionId: ID!, accept: Boolean!): PendingDecision!
    @deprecated(reason: "Phase 8: use respondToPromotion (returns the updated Tool).")

  # Phase 3 — Universal Gate, Hard-Rule Floor & the First Tool.
  # Compose a tool call against a task. Runs the gate; on RequestDecision
  # writes an ApprovalRequest and starts the durable ToolCallWorkflow that
  # awaits resolution. Errors:
  #   TOOL_UNKNOWN     — toolGlobalUri does not match any tool row
  #   TASK_NOT_OPEN    — task is not in an EXECUTION-eligible state
  #   PERMISSION_DENIED — viewer cannot act on the task
  proposeToolCall(
    taskId: ID!
    toolGlobalUri: String!
    payload: JSON!
  ): ApprovalRequest!

  # Phase 4 — OWNER-PRINCIPAL-ONLY tool tuning mutations. Resolver MUST
  # reject any viewer with Principal.Kind != "user" with PERMISSION_DENIED
  # before any DB write (structural check via auth.RequireOwner, not a
  # runtime feature flag).
  #
  # setToolPermissions validates against the floor's schema:
  #   { read_only: bool, spend: bool,
  #     irreversible_third_party: "never"|"always"|"stranger_recipient",
  #     secret_classes: [string] }
  # Errors:
  #   PERMISSION_DENIED, TOOL_UNKNOWN, INVALID_PERMISSIONS.
  setToolPermissions(toolId: ID!, permissions: JSON!): Tool!

  # setToolOverseerInstructions replaces the tool's overseer instructions
  # string. Empty string is allowed (treated as "no owner guidance" — the
  # overseer returns RequestDecision conservatively).
  # Errors: PERMISSION_DENIED, TOOL_UNKNOWN.
  setToolOverseerInstructions(toolId: ID!, instructions: String!): Tool!

  # Phase 8 — Calibration & the Earned-Autonomy Ratchet (additive, Path 1).
  #
  # respondToPromotion is the SINGLE path that RAISES a tool's autonomy.
  # OWNER-ONLY — structurally guarded by auth.RequireOwner(ctx) FIRST; an
  # agent (non-"user") principal is refused before any DB write
  # (Constitution IV; NFR-004).
  #   accept:true  → trust score jumps into the proposed band AND a live
  #                  per-routine grant is created; returns the updated Tool.
  #   accept:false → no change; the proposal is withdrawn and will not
  #                  re-propose until NEW matured-clean outcomes accrue.
  # Errors: PERMISSION_DENIED, DECISION_UNKNOWN, DECISION_ALREADY_RESOLVED.
  respondToPromotion(proposalId: ID!, accept: Boolean!): Tool!

  # flagOutcome is the owner's retroactive veto: records the outcome BAD and
  # REFLEXIVELY demotes the tool (proportional score decrement clamped at the
  # EXECUTE_GATED baseline + revoke the affected routine's grant) in one
  # operation. OWNER-ONLY. Returns the updated Tool. Demotion needs no
  # approval. Errors: PERMISSION_DENIED, TASK_UNKNOWN, TOOL_UNKNOWN.
  flagOutcome(taskId: ID!, toolId: ID!, reason: String): Tool!

  # Post-completion feedback (additive, Path 1).
  #
  # sendFeedbackMessage appends the owner's message to a FeedbackRequest
  # conversation and returns the updated request (with the agent's reply +
  # refreshed draftGuidance). Errors: DECISION_NOT_FOUND, DECISION_KIND_MISMATCH,
  # DECISION_ALREADY_RESOLVED.
  sendFeedbackMessage(decisionId: ID!, text: String!): FeedbackRequest!

  # acceptFeedbackGuidance stores `guidance` VERBATIM as an active AgentGuidance
  # note (no further modification), scoped GLOBAL or to `agentConfigId` (required
  # when scope=AGENT), optionally records a 1–5 satisfaction `rating` (low →
  # calibration demotion), resolves the decision, and wakes the feedback
  # workflow. OWNER-ONLY (auth.RequireOwner FIRST). Pass empty guidance to accept
  # with no note (rating only). Errors: PERMISSION_DENIED, DECISION_NOT_FOUND,
  # DECISION_KIND_MISMATCH, DECISION_ALREADY_RESOLVED, INVALID_SCOPE.
  acceptFeedbackGuidance(
    decisionId: ID!
    guidance: String!
    scope: GuidanceScope!
    agentConfigId: ID
    rating: Int
  ): AgentGuidance

  # dismissFeedback closes a FeedbackRequest with no guidance. Optionally records
  # a 1–5 rating (low → calibration demotion). OWNER-ONLY.
  dismissFeedback(decisionId: ID!, rating: Int): PendingDecision!

  # deactivateAgentGuidance retires an active guidance note so it stops being
  # injected into agent prompts. OWNER-ONLY.
  deactivateAgentGuidance(guidanceId: ID!): AgentGuidance!
}

# ----- Subscriptions ---------------------------------------------------

type Subscription {
  # Ranked sibling of inboxItemArrived — emits the InboxEntry envelope (with
  # urgency) so live arrivals can be slotted into the ranked feed.
  inboxEntryArrived: InboxEntry!
  inboxItemArrived: InboxItem! @deprecated(reason: "Use inboxEntryArrived — carries the ranked envelope.")
  taskChanged(taskId: ID): Task!
  notificationReceived: Notification!
}

# =========================================================================
# Phase 6: Agent Layer & Routing — ADDITIVE (Path 1).
# =========================================================================

enum AgentStage { TRIAGE EXPANSION EXECUTION }

type AgentConfigSummary {
  id: ID!
  name: String!
  stage: AgentStage!
  isHuman: Boolean!
  model: String
  origin: String!
  version: Int!
}

type RoutingDecision {
  stage: AgentStage!
  eligibleSet: [AgentConfigSummary!]!
  picked: AgentConfigSummary
  pickedHuman: Boolean!
}

type StageSlot {
  stage: AgentStage!
  occupant: AgentConfigSummary
  isHuman: Boolean!
}

extend type Task {
  stageSlots: [StageSlot!]!
}

extend type Query {
  agentConfigs(stage: AgentStage): [AgentConfigSummary!]!
}

# ActivityEvent is one row of a task's audit DAG — an agent run, a tool-call
# step (composed → gate verdict → decision → dispatched → outcome), a stage
# advance, a state transition, etc. `kind` is the audit kind; `detail` is the
# raw typed payload for that kind (tokens, tool name, verdict, outcome, …);
# `inReplyTo` chains an event to its parent for threaded rendering.
type ActivityEvent {
  id: ID!
  kind: String!
  at: Time!
  actor: String!
  inReplyTo: ID
  detail: JSON
}

extend type Task {
  # The full audit timeline for this task, chronological (oldest first).
  activity: [ActivityEvent!]!
}
