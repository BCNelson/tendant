# Tendant operator-edge GraphQL contract — v1 (Phase 1 mutation surface + AgentAssignment).
#
# Source: v2 spec Appendix B, narrowed to Phase 1 scope. This is the versioned
# operator-edge contract (Principle VII). Phase 1 amends Phase 0's read-only
# subset ADDITIVELY: new types, new fields, and a `Mutation` type land for the
# first time. The `TaskState` enum's `ELIGIBLE` value is renamed to `WAITING`
# in this revision — permitted because no client has yet consumed `ELIGIBLE`;
# once a client has, future renames MUST be deprecation-shaped.
#
# Implementation: this SDL is the contract of record; the working schema lives
# at services/api/graph/schema.graphqls (kept in sync; CI checks gqlgen drift).

scalar Time
scalar JSON

# `WAITING` replaces Phase 0's `ELIGIBLE` (see Phase 1 spec Q3): it is the
# *holding* state for tasks whose post-expansion readiness conditions have
# not yet been met. In Phase 1 the predicate is trivially true, so WAITING
# is structurally present but not entered on the happy path.
enum TaskState     { PROPOSED ACCEPTED WAITING EXECUTING DONE DISMISSED HALTED }
enum ChainStage    { CREATION TRIAGE EXPANSION EXECUTION COMPLETION }
enum AutonomyLevel { NONE ENRICH_ONLY PROPOSE EXECUTE_GATED EXECUTE_AUTO }

# Every actor is a Principal; federation-shaped via globalUri (Principle VIII).
interface Principal { id: ID!  globalUri: String!  displayName: String! }
type User implements Principal { id: ID!  globalUri: String!  displayName: String! }
type Bot  implements Principal { id: ID!  globalUri: String!  displayName: String! }

type WorkflowRef { id: ID!  startedAt: Time! }

type Task {
  id: ID!  globalUri: String!
  title: String!  description: String
  state: TaskState!
  currentStage: ChainStage!
  autonomy: AutonomyLevel!         # resolved readout, NOT a stored/settable dial (P1)
  provenance: JSON
  contextRefs: JSON
  findings: JSON
  workflow: WorkflowRef            # null until a chain workflow attaches (P2)
  openAssignment: AgentAssignment  # NEW: the open human slot if any, else null
  createdAt: Time!  editedAt: Time
}

# A human (or, post-Phase-6, agent) routed into a stage slot. Sub-resource of
# Task; addressed via its parent per Principle VIII v1.2.0 — no globalUri here.
type AgentAssignment {
  id: ID!
  task: Task!
  stage: ChainStage!
  fromAgent: Principal             # null in Phase 1 (owner-authored, no upstream agent)
  ask: String!                     # stage-default text in Phase 1; agent-authored from Phase 6
  gatheredContext: JSON            # {} in Phase 1; populated by upstream agents from Phase 6
  createdAt: Time!
  resolvedAt: Time                 # null while open
}

# Relay connection — hand-written (gqlgen has no connection generator); keyset cursors.
type TaskEdge { node: Task!  cursor: String! }
type TaskConnection { edges: [TaskEdge!]!  pageInfo: PageInfo! }
type PageInfo { hasNextPage: Boolean!  endCursor: String }

type Query {
  viewer: User
  task(id: ID!): Task
  tasks(first: Int, after: String, state: TaskState): TaskConnection!
}

type Mutation {
  # Owner-authored task creation. Persists the task in `state=ACCEPTED`,
  # `currentStage=CREATION`, attaches a chain workflow, and starts it. The
  # chain workflow immediately advances past CREATION to TRIAGE and opens
  # the first human slot.
  createTask(title: String!, description: String): Task!

  # Resolve the open AgentAssignment for the given task with `result` payload.
  # The chain workflow's durable wait resolves, the slot is closed, the audit
  # row is written, and the chain advances to the next stage. Fails with a
  # typed error if no open assignment exists, the task is terminal, or the
  # assignment was already resolved (Phase 1 spec Q5 / edge cases).
  completeTask(taskId: ID!, result: JSON): Task!

  # Halt forward progress and move the task to HALTED. Calls
  # dbos.CancelWorkflow on the live chain workflow; the running step (if any)
  # finishes, then the chain halts at the next step boundary — so an in-flight
  # completeTask still resolves the current slot, but the next stage does not
  # dispatch (Phase 1 spec Q2). No rollback of prior effects (Principle V).
  # Fails with TASK_ALREADY_TERMINAL on terminal tasks (Phase 1 spec Q5).
  cancelTask(taskId: ID!): Task!

  # Transition PROPOSED → ACCEPTED and start a chain workflow. Lands in the
  # contract additively in Phase 1; exercised once intake (Phase 7) starts
  # producing PROPOSED tasks. No-op in Phase 1 except as a contract surface.
  acceptProposedTask(taskId: ID!): Task!

  # Transition PROPOSED → DISMISSED. Reason is captured in the audit row.
  # As with acceptProposedTask, lands additively in Phase 1; exercised in
  # Phase 7.
  dismissProposedTask(taskId: ID!, reason: String): Task!
}

# ── Deferred to later phases (listed for contract-evolution awareness only) ──
# union InboxItem = ApprovalRequest | AgentQuestion | PromotionProposal | AgentAssignment  # Phase 2
# type Subscription { inboxItemArrived, taskChanged, notificationReceived }                # Phase 2
# auditTrail(taskId), tool(id), connectors, ...                                            # later phases
# Mutation { approveArtifact, … }                                                          # Phase 3+
