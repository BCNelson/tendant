# Tendant operator-edge GraphQL contract — v1 (Phase 0 read-only subset)
#
# Source: v2 spec Appendix B. This is the versioned operator-edge contract (Principle VII).
# Phase 0 ships ONLY the read-only subset below. Intent-named mutations and the
# inbox/audit/subscription surface are deferred (Phase 2) and MUST be added additively
# (new types, fields, union members) — never a silent break.
#
# Implementation: this SDL is the contract of record; the working schema lives at
# services/api/graph/schema.graphqls (kept in sync; CI checks gqlgen drift).

scalar Time
scalar JSON

enum TaskState     { PROPOSED ACCEPTED ELIGIBLE EXECUTING DONE DISMISSED HALTED }
enum ChainStage    { CREATION TRIAGE EXPANSION EXECUTION COMPLETION }
enum AutonomyLevel { NONE ENRICH_ONLY PROPOSE EXECUTE_GATED EXECUTE_AUTO }

# Every actor is a Principal; federation-shaped via globalUri (Principle VIII).
interface Principal { id: ID!  globalUri: String!  displayName: String! }
type User implements Principal { id: ID!  globalUri: String!  displayName: String! }
type Bot  implements Principal { id: ID!  globalUri: String!  displayName: String! }

type WorkflowRef { id: ID!  startedAt: Time! }

type Task {
  id: ID!  globalUri: String!
  title: String!  description: String
  state: TaskState!
  currentStage: ChainStage!
  autonomy: AutonomyLevel!      # resolved readout, NOT a stored/settable dial (P1)
  provenance: JSON
  contextRefs: JSON
  findings: JSON
  workflow: WorkflowRef         # null until a chain workflow attaches (P2)
  createdAt: Time!  editedAt: Time
}

# Relay connection — hand-written (gqlgen has no connection generator); keyset cursors.
type TaskEdge { node: Task!  cursor: String! }
type TaskConnection { edges: [TaskEdge!]!  pageInfo: PageInfo! }
type PageInfo { hasNextPage: Boolean!  endCursor: String }

type Query {
  viewer: User
  task(id: ID!): Task
  tasks(first: Int, after: String, state: TaskState): TaskConnection!
}

# ── Deferred to later phases (listed for contract-evolution awareness only) ──
# type Mutation { ... acceptProposedTask, completeTask, approveArtifact, ... }   # Phase 2+
# union InboxItem = ApprovalRequest | AgentQuestion | PromotionProposal | AgentAssignment  # Phase 2
# type Subscription { inboxItemArrived, taskChanged, notificationReceived }       # Phase 2
# auditTrail(taskId), tool(id), connectors, ...                                   # later phases
